# ==============================================================================
# MONVEIL — Environment Configuration
# Privacy-Preserving Consumer Payment Verification on Monad
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Monad Testnet Deployment (Smart Contract Registry)
# ------------------------------------------------------------------------------
# Private key of the deployer account for scripts/deployMonveil.js (without 0x or with 0x)
# DO NOT commit real private keys. Never expose private keys in frontend bundles.
DEPLOYER_PRIVATE_KEY=

# Monad Testnet RPC endpoint (Chain ID: 10143)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Deployed MonveilVerificationRegistry contract address on Monad Testnet
# If unset, defaults to pre-configured address: 0x4a6b58611F36928e18FDAb821cEa7fE195F483c7
VITE_MONVEIL_REGISTRY_ADDRESS=0x4a6b58611F36928e18FDAb821cEa7fE195F483c7

# ------------------------------------------------------------------------------
# 2. Agora AUSD Stablecoin Integration ($10,000 Bounty)
# ------------------------------------------------------------------------------
# Agora AUSD ERC-20 token contract on Monad Testnet
# If unset, defaults to pre-configured address: 0x83eF2633E78e7a64B4c7333B32E1858737EB6673
VITE_AGORA_AUSD_ADDRESS=0x83eF2633E78e7a64B4c7333B32E1858737EB6673

# ------------------------------------------------------------------------------
# 3. Kimi AI Reasoning Engine ($3,000 API Credits Bounty)
# ------------------------------------------------------------------------------
# Moonshot / Kimi API Key for plain-English payment verification explanations
# Calls are proxied securely server-side through Vite /api/ai/explain middleware
# If unset or empty, the app falls back seamlessly to deterministic rule-based explanations
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# ------------------------------------------------------------------------------
# 4. Envio HyperIndex Event Indexer ($1,000 Bounty)
# ------------------------------------------------------------------------------
# Envio HyperIndex GraphQL endpoint for indexed Monveil on-chain verification events
# Default local Envio endpoint is http://localhost:8080/v1/graphql
# If offline or unreachable, Activity page falls back gracefully with status indicators
ENVIO_GRAPHQL_ENDPOINT=http://localhost:8080/v1/graphql

# ------------------------------------------------------------------------------
# 5. Standalone API Server (Optional)
# ------------------------------------------------------------------------------
# Port for standalone server/api.js (Vite dev server already proxies /api/* automatically)
PORT=3001
